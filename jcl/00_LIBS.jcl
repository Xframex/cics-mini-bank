//BKLIBS  JOB (ACCT),'BANK LIBS',CLASS=A,MSGCLASS=H,
//             NOTIFY=&SYSUID
//* RUN ONLY IF THESE DATASETS DO NOT ALREADY EXIST.
//* BMS, SOURCE, JCL AND COPY ARE 80-BYTE PDS MEMBERS.
//ALLOC    EXEC PGM=IEFBR14
//SRC      DD DSN=Z63170.BANK.SRC,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5,30)),DSORG=PO,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//BMS      DD DSN=Z63170.BANK.BMS,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5,30)),DSORG=PO,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//COPY     DD DSN=Z63170.BANK.COPY,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5,30)),DSORG=PO,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//JCL      DD DSN=Z63170.BANK.JCL,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5,30)),DSORG=PO,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//LOAD     DD DSN=Z63170.BANK.LOAD,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5,20)),
//            DSNTYPE=LIBRARY,DCB=(RECFM=U,BLKSIZE=32760)
