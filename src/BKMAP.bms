BKMAP    DFHMSD TYPE=MAP,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,           X
               TIOAPFX=YES
BKLGIN   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=FREEKB
         DFHMDF POS=(2,20),LENGTH=38,ATTRB=(ASKIP,BRT),                X
               INITIAL='MINI BANK - CICS ONLINE DEMONSTRATION'
         DFHMDF POS=(4,10),LENGTH=9,ATTRB=(ASKIP,NORM),                X
               INITIAL='User ID :'
USERID   DFHMDF POS=(4,23),LENGTH=8,ATTRB=(UNPROT,IC)
         DFHMDF POS=(6,10),LENGTH=9,ATTRB=(ASKIP,NORM),                X
               INITIAL='PIN     :'
PIN      DFHMDF POS=(6,23),LENGTH=4,ATTRB=(UNPROT,DRK)
         DFHMDF POS=(9,10),LENGTH=45,ATTRB=(ASKIP,NORM),               X
               INITIAL='Use DEMO / 1234 (training credentials only)'
LMSG     DFHMDF POS=(12,10),LENGTH=60,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(22,10),LENGTH=24,ATTRB=(ASKIP,NORM),              X
               INITIAL='ENTER=Sign on  F3=Exit'
BKMAIN   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=FREEKB
         DFHMDF POS=(2,20),LENGTH=37,ATTRB=(ASKIP,BRT),                X
               INITIAL='MINI BANK - ACCOUNT OPERATIONS (BK01)'
         DFHMDF POS=(4,6),LENGTH=5,ATTRB=(ASKIP,NORM),                 X
               INITIAL='User:'
WHO      DFHMDF POS=(4,15),LENGTH=8,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(6,6),LENGTH=30,ATTRB=(ASKIP,NORM),                X
               INITIAL='Action (I=Inquiry T=Transfer):'
ACT      DFHMDF POS=(6,40),LENGTH=1,ATTRB=(UNPROT,IC)
         DFHMDF POS=(8,6),LENGTH=13,ATTRB=(ASKIP,NORM),                X
               INITIAL='From Account:'
FROMA    DFHMDF POS=(8,25),LENGTH=8,ATTRB=(UNPROT,NORM)
         DFHMDF POS=(10,6),LENGTH=11,ATTRB=(ASKIP,NORM),               X
               INITIAL='To Account:'
TOA      DFHMDF POS=(10,25),LENGTH=8,ATTRB=(UNPROT,NORM)
         DFHMDF POS=(12,6),LENGTH=21,ATTRB=(ASKIP,NORM),               X
               INITIAL='Amount (0000012.50):'
AMT      DFHMDF POS=(12,30),LENGTH=10,ATTRB=(UNPROT,NORM)
         DFHMDF POS=(15,6),LENGTH=8,ATTRB=(ASKIP,NORM),                X
               INITIAL='Balance:'
BAL      DFHMDF POS=(15,25),LENGTH=14,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(18,6),LENGTH=7,ATTRB=(ASKIP,NORM),                X
               INITIAL='Status:'
MSG      DFHMDF POS=(18,15),LENGTH=60,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(22,6),LENGTH=35,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=Submit  F3=Logoff  (TRAINING)'
         DFHMSD TYPE=FINAL
         END