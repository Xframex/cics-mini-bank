//BKDAYJ  JOB (ACCT),'BANK END DAY',CLASS=A,MSGCLASS=H,
//             NOTIFY=&SYSUID
//* CLOSE BKACCT IN CICS AND QUIESCE BANK TRANSACTIONS FIRST.
//* SNAPSHOT EXISTING VSAM INTO AN FB40 SEQUENTIAL DATA SET.
//* CHANGE SNAPSHOT DSN EACH DAY OR DELETE AFTER ARCHIVING.
//COPY     EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//ACCTVS   DD DISP=SHR,DSN=Z63170.BANK.ACCT.KSDS
//ACCTPS   DD DSN=Z63170.BANK.DAY.SNAP,
//             DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//             SPACE=(TRK,(2,2),RLSE),
//             DCB=(RECFM=FB,LRECL=40,BLKSIZE=4000)
//SYSIN    DD *
  REPRO INFILE(ACCTVS) OUTFILE(ACCTPS)
/*
//REPORT   EXEC PGM=BKDAY,COND=(0,NE,COPY)
//STEPLIB  DD DISP=SHR,DSN=Z63170.BANK.LOAD
//ACCTIN   DD DISP=SHR,DSN=Z63170.BANK.DAY.SNAP
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
