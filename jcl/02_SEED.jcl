//BKSEEDJ JOB (ACCT),'BANK SEED',CLASS=A,MSGCLASS=H,
//             NOTIFY=&SYSUID
//* FIRST RUN ONLY; MUST BE CLOSED TO CICS.
//* BKSEED EXECUTABLE MUST HAVE BEEN COMPILED IN BANK.LOAD.
//SEED     EXEC PGM=BKSEED
//STEPLIB  DD DISP=SHR,DSN=Z63170.BANK.LOAD
//ACCTVS   DD DISP=OLD,DSN=Z63170.BANK.ACCT.KSDS
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
